<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Wizard Form View -->
    <record id="view_finance_popup_wizard_form" model="ir.ui.view">
        <field name="name">Formulaire de génération de rapport d'aide à la saisie du Cerfa 2091-SD (TMP / TFOP)</field>
        <field name="model">account.taxes.cerfa_report.wizard</field>
        <field name="arch" type="xml">
        <form string="Formulaire">
            <group string="Configuration">
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="company_ids" widget="many2many_tags"/>
                <field name="ignore_cutoff"/>
            </group>
            <group string="Paramétrage du rendu">
                <field name="split_by_company"/>
                <field name="paginate"/>
            </group>
            <footer>
                <button name="action_confirm" string="Générer PDF" type="object" class="btn-primary"/>
                <button string="Annuler" class="btn-secondary" special="cancel"/>
            </footer>
        </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_cerfa_2091_sd_wizard" model="ir.actions.act_window">
        <field name="name">Rapport d'aide à la saisie du Cerfa 2091-SD (TMP / TFOP)</field>
        <field name="res_model">account.taxes.cerfa_report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>