<odoo>
    <!--
      Valeurs de départ, modifiables par l'établissement. `noupdate="1"` :
      une mise à jour du module ne doit jamais réécrire un libellé déjà porté
      par des lignes du registre.
    -->
    <data noupdate="1">

        <!-- Provenances (art. R321-3 3°, art. 56 J quindecies) -->
        <record id="provenance_bijoux_personnels" model="livre.police.provenance">
            <field name="name">Bijoux personnels</field>
            <field name="sequence">10</field>
            <field name="note">Objets portés ou détenus par le vendeur lui-même.</field>
        </record>
        <record id="provenance_heritage" model="livre.police.provenance">
            <field name="name">Héritage ou succession</field>
            <field name="sequence">20</field>
            <field name="note">Reçus d'un parent, par succession ou donation.</field>
        </record>
        <record id="provenance_cadeau" model="livre.police.provenance">
            <field name="name">Cadeau</field>
            <field name="sequence">30</field>
        </record>
        <record id="provenance_achat_anterieur" model="livre.police.provenance">
            <field name="name">Achat antérieur</field>
            <field name="sequence">40</field>
            <field name="note">Acheté neuf ou d'occasion par le vendeur.</field>
        </record>
        <record id="provenance_brocante" model="livre.police.provenance">
            <field name="name">Brocante ou vide-grenier</field>
            <field name="sequence">50</field>
        </record>
        <record id="provenance_stock_professionnel" model="livre.police.provenance">
            <field name="name">Stock professionnel</field>
            <field name="sequence">60</field>
            <field name="note">Rachat à un confrère : le métal vient de son
                propre stock, tracé à son registre.</field>
        </record>
        <record id="provenance_registre_anterieur" model="livre.police.provenance">
            <field name="name">Reprise du registre antérieur</field>
            <field name="sequence">90</field>
            <field name="note">Réservé à l'inventaire d'ouverture.</field>
        </record>

        <!-- Qualités et professions (art. R321-3 1°) -->
        <record id="qualite_salarie" model="livre.police.qualite">
            <field name="name">Salarié(e)</field>
            <field name="sequence">10</field>
        </record>
        <record id="qualite_retraite" model="livre.police.qualite">
            <field name="name">Retraité(e)</field>
            <field name="sequence">20</field>
        </record>
        <record id="qualite_sans_profession" model="livre.police.qualite">
            <field name="name">Sans profession</field>
            <field name="sequence">30</field>
        </record>
        <record id="qualite_etudiant" model="livre.police.qualite">
            <field name="name">Étudiant(e)</field>
            <field name="sequence">40</field>
        </record>
        <record id="qualite_artisan_commercant" model="livre.police.qualite">
            <field name="name">Artisan ou commerçant</field>
            <field name="sequence">50</field>
        </record>
        <record id="qualite_profession_liberale" model="livre.police.qualite">
            <field name="name">Profession libérale</field>
            <field name="sequence">60</field>
        </record>
        <record id="qualite_agriculteur" model="livre.police.qualite">
            <field name="name">Agriculteur</field>
            <field name="sequence">70</field>
        </record>
        <record id="qualite_fonctionnaire" model="livre.police.qualite">
            <field name="name">Fonctionnaire</field>
            <field name="sequence">80</field>
        </record>

        <!-- Qualités par lesquelles on engage une société -->
        <record id="qualite_gerant" model="livre.police.qualite">
            <field name="name">Gérant(e)</field>
            <field name="sequence">100</field>
            <field name="representant" eval="True"/>
        </record>
        <record id="qualite_president" model="livre.police.qualite">
            <field name="name">Président(e)</field>
            <field name="sequence">110</field>
            <field name="representant" eval="True"/>
        </record>
        <record id="qualite_mandataire" model="livre.police.qualite">
            <field name="name">Mandataire</field>
            <field name="sequence">120</field>
            <field name="representant" eval="True"/>
        </record>
        <record id="qualite_salarie_habilite" model="livre.police.qualite">
            <field name="name">Salarié(e) habilité(e)</field>
            <field name="sequence">130</field>
            <field name="representant" eval="True"/>
        </record>

    </data>
</odoo>
