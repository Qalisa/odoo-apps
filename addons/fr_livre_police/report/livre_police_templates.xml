<odoo>

    <!--
        Édition du registre, calquée sur le cahier du commerce : une page de
        garde portant l'ouverture, la clôture et le visa de l'autorité, puis
        la réglure de la double page.

        Le registre ne totalise pas le métal, il le ventile — par canal
        d'acquisition (fabricants, particuliers, autres, dépôt) et, dans
        chaque canal, par métal (platine, or et alliages, argent). Une ligne
        ne sert donc qu'une seule des douze cases de poids.

        Les canaux que l'établissement ne pratique pas restent en place,
        grisés : un registre dont on retire des colonnes est un registre
        remanié, alors que le grisé énonce ce qui est.

        Les feuillets sont numérotés et datés (art. 56 J sexdecies : « les
        feuillets informatiques doivent être identifiés, numérotés et datés »).
    -->

    <template id="report_livre_police">
        <t t-call="web.html_container">

            <div class="header" style="font-size:7.5pt;border-bottom:1px solid #000;
                                       padding-bottom:2px;white-space:nowrap;">
                <!-- Casse mixte : la fonte du moteur d'édition ne porte pas
                     les capitales accentuées, et « METAUX PRECIEUX » ferait
                     négligé sur une pièce présentée à l'autorité. -->
                <span style="letter-spacing:0.5px;font-weight:bold;">
                    Livre de police — registre des métaux précieux
                </span>
                <span style="float:right;">
                    Art. 537 CGI · ann. IV 56 J · c. pén. R321-3
                </span>
            </div>

            <div class="footer" style="font-size:7.5pt;border-top:1px solid #000;
                                       padding-top:2px;">
                <span>
                    Édité le
                    <t t-out="context_timestamp(datetime.datetime.now())
                              .strftime('%d/%m/%Y à %H:%M')"/>
                </span>
                <span style="float:right;">
                    Feuillet <span class="page"/> / <span class="topage"/>
                </span>
            </div>

            <div class="article">
                <t t-set="inscrits" t-value="docs.filtered('police_registered')"/>
                <t t-set="par_societe" t-value="{}"/>
                <t t-foreach="inscrits" t-as="lot">
                    <t t-set="_" t-value="par_societe.setdefault(
                                            lot.company_id, []).append(lot)"/>
                </t>

                <t t-set="canaux" t-value="list(docs.CANAUX)"/>
                <t t-set="gris" t-value="docs.CANAUX_INUTILISES"/>
                <t t-set="titres" t-value="{
                        'fabricants': 'Objets achetés aux fabricants',
                        'particuliers': 'Objets d&#8217;occasion achetés à des particuliers',
                        'autres': 'Autres achats',
                        'tiers': 'Objets confiés par des tiers'}"/>

                <t t-set="cellule"
                   t-value="'border:1px solid #1b3f6b;padding:1.2mm 1mm;'"/>
                <t t-set="cellule_ref" t-value="cellule + 'font-weight:bold;'"/>
                <t t-set="cellule_pre" t-value="cellule + 'white-space:pre-line;'"/>
                <t t-set="cellule_num" t-value="cellule + 'text-align:right;'"/>
                <t t-set="fond_gris" t-value="'background:#e4e9ef;color:#8894a4;'"/>
                <t t-set="entete"
                   t-value="'border:1px solid #1b3f6b;padding:1mm 0.5mm;'
                            'text-align:center;vertical-align:middle;'
                            'color:#1b3f6b;font-weight:normal;'"/>

                <t t-foreach="par_societe" t-as="societe">
                    <t t-set="lignes" t-value="par_societe[societe]"/>

                    <!-- Page de garde -->
                    <div t-if="not societe_first"
                         style="page-break-before:always;"/>
                    <div style="border:2px solid #1b3f6b;padding:14mm 12mm;
                                margin:4mm 20mm;color:#1b3f6b;">
                        <div style="text-align:center;">
                            <div style="font-size:26pt;font-weight:bold;
                                        letter-spacing:2px;">LIVRE DE POLICE</div>
                            <div style="font-size:12pt;margin-top:2mm;">
                                Registre des achats, ventes, réceptions et
                                livraisons de matières d'or, d'argent et de platine
                            </div>
                        </div>

                        <div style="margin-top:10mm;font-size:11pt;color:#000;">
                            <div style="font-weight:bold;font-size:13pt;"
                                 t-out="societe.name"/>
                            <div t-if="societe.street" t-out="societe.street"/>
                            <div>
                                <span t-out="societe.zip"/>
                                <span t-out="societe.city"/>
                            </div>
                            <div t-if="societe.vat">
                                N° TVA <span t-out="societe.vat"/>
                            </div>
                        </div>

                        <table style="width:100%;margin-top:10mm;font-size:11pt;
                                      color:#000;">
                            <tr>
                                <td style="width:50%;padding:2mm 0;">
                                    Registre ouvert le
                                    <span style="border-bottom:1px solid #000;
                                                 padding:0 8mm;font-weight:bold;"
                                          t-out="societe.police_start_date"
                                          t-options="{'widget': 'date'}"/>
                                </td>
                                <td style="width:50%;padding:2mm 0;">
                                    Registre clôturé le
                                    <span style="border-bottom:1px solid #000;
                                                 padding:0 14mm;">&#160;</span>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:2mm 0;">
                                    Inventaire d'ouverture effectué le
                                    <span style="border-bottom:1px solid #000;
                                                 padding:0 6mm;font-weight:bold;"
                                          t-out="societe.police_opening_date"
                                          t-options="{'widget': 'date'}"/>
                                </td>
                                <td style="padding:2mm 0;">
                                    Lignes portées au présent registre :
                                    <span style="font-weight:bold;"
                                          t-out="len(lignes)"/>
                                </td>
                            </tr>
                        </table>

                        <div style="margin-top:9mm;font-size:9pt;text-align:justify;
                                    color:#000;">
                            Les fabricants et les marchands d'or, d'argent et de
                            platine ouvrés ou non ouvrés ou d'alliage de ces
                            métaux, et, d'une manière générale, toutes les
                            personnes qui détiennent des matières de l'espèce pour
                            l'exercice de leur profession, doivent tenir un
                            registre de leurs achats, ventes, réceptions et
                            livraisons (art. 537 du code général des impôts). Le
                            registre indique, sur justification de leur identité,
                            les noms, prénoms et adresses des personnes ayant
                            vendu ou confié les matières ou les ouvrages, ainsi
                            que la nature, le nombre, le poids, le titre, la date
                            d'entrée et de sortie et l'origine de ceux-ci, afin
                            de permettre leur identification individuelle
                            (art. 56 J quindecies de l'annexe IV). Il est
                            présenté à l'autorité publique à toute réquisition.
                        </div>

                        <!-- Trois durées se superposent : six ans au titre du
                             contrôle fiscal (LPF, art. L. 102 B, visé par
                             l'art. 56 J quaterdecies), cinq ans pour le
                             registre des objets mobiliers tenu sur papier
                             (c. pén., art. R321-6), dix ans lorsqu'il est tenu
                             sous forme informatisée (art. R321-6-1) — ce qui
                             est le cas ici. La plus longue s'impose : l'écrire
                             évite qu'un registre soit détruit conforme à un
                             texte et fautif au regard d'un autre. -->
                        <div style="margin-top:4mm;font-size:9pt;text-align:justify;
                                    color:#000;">
                            Ce registre étant tenu sous forme informatisée, le
                            traitement garantit l'intégrité, l'intangibilité et
                            la sécurité des données enregistrées, et les
                            informations sont conservées <b>dix ans</b>
                            (c. pén., art. R321-6-1). Cette durée est la plus
                            longue de celles applicables : cinq ans pour un
                            registre tenu sur papier (art. R321-6) et six ans au
                            titre du contrôle fiscal (LPF, art. L. 102 B).
                        </div>

                        <div style="margin-top:9mm;border:1px solid #1b3f6b;
                                    padding:3mm;height:34mm;">
                            <div style="font-weight:bold;font-size:10pt;">
                                Visa du commissaire de police ou du maire
                            </div>
                        </div>
                    </div>

                    <!-- Réglure -->
                    <div style="page-break-before:always;"/>
                    <div style="font-weight:bold;font-size:10pt;margin-bottom:2mm;
                                color:#1b3f6b;" t-out="societe.name"/>
                    <table style="table-layout:fixed;width:100%;font-size:6.5pt;
                                  border-collapse:collapse;">
                        <colgroup>
                            <col style="width:5%"/><col style="width:4%"/>
                            <col style="width:15%"/><col style="width:13%"/>
                            <col style="width:3%"/>
                            <col style="width:3.2%"/><col style="width:3.2%"/><col style="width:3.2%"/>
                            <col style="width:3.2%"/><col style="width:3.2%"/><col style="width:3.2%"/>
                            <col style="width:3.2%"/><col style="width:3.2%"/><col style="width:3.2%"/>
                            <col style="width:3.2%"/><col style="width:3.2%"/><col style="width:3.2%"/>
                            <col style="width:3.8%"/><col style="width:3.8%"/>
                            <col style="width:14%"/>
                        </colgroup>
                        <thead>
                            <tr>
                                <th t-att-style="entete" rowspan="3">
                                    N° d'ordre<br/>ou<br/>référence</th>
                                <th t-att-style="entete" rowspan="3">
                                    Date<br/>des<br/>entrées</th>
                                <th t-att-style="entete" rowspan="3">
                                    <div style="font-size:8pt;letter-spacing:1px;">
                                        Origine des achats</div>
                                    <div style="font-size:8pt;letter-spacing:1px;">
                                        Noms et adresses des fournisseurs</div>
                                    <div style="font-size:6pt;">(en cas d'achat à
                                        des particuliers noter le nom et le n° de
                                        la carte d'identité)</div>
                                </th>
                                <th t-att-style="entete" rowspan="3">
                                    Désignation des objets achetés ou confiés,
                                    et/ou n° d'inscription dans un catalogue
                                    comptable officiel</th>
                                <th t-att-style="entete" rowspan="3">Nombre</th>
                                <t t-foreach="canaux" t-as="canal">
                                    <th t-att-style="entete + (canal in gris
                                                               and fond_gris or '')"
                                        t-att-colspan="canal == 'tiers' and 4 or 3"
                                        t-out="titres[canal]"/>
                                </t>
                                <th t-att-style="entete" rowspan="3">
                                    Date<br/>de sortie<br/>des objets<br/>vendus</th>
                                <th t-att-style="entete" rowspan="3">
                                    <span style="font-size:8pt;letter-spacing:1px;">
                                        Observations</span></th>
                            </tr>
                            <tr>
                                <t t-foreach="canaux" t-as="canal">
                                    <th t-att-style="entete + (canal in gris
                                                               and fond_gris or '')"
                                        colspan="3">
                                        <span style="font-size:8pt;letter-spacing:2px;">
                                            Poids</span></th>
                                </t>
                                <th t-att-style="entete + fond_gris" rowspan="2">
                                    Date<br/>de la<br/>remise</th>
                            </tr>
                            <tr>
                                <t t-foreach="canaux" t-as="canal">
                                    <t t-set="st" t-value="entete + (canal in gris
                                                                     and fond_gris or '')"/>
                                    <th t-att-style="st">Platine</th>
                                    <th t-att-style="st">Or et<br/>alliages</th>
                                    <th t-att-style="st">Argent</th>
                                </t>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="lignes" t-as="lot"
                                style="page-break-inside:avoid;">
                                <t t-set="cases" t-value="lot._police_cases_poids()"/>
                                <!-- Valeurs dans un `span` enfant, jamais en
                                     `t-out` sur la cellule : QWeb retire la
                                     balise quand la valeur est vide, et la
                                     ligne se décalerait d'une colonne. -->
                                <td t-att-style="cellule_ref">
                                    <span t-out="lot.name"/></td>
                                <td t-att-style="cellule">
                                    <span t-out="lot.police_entry_date"
                                          t-options="{'widget': 'date'}"/></td>
                                <td t-att-style="cellule_pre">
                                    <t t-set="identite" t-value="lot._police_vendeur()"/>
                                    <span t-if="identite" t-out="identite"/>
                                    <span t-else="" style="font-style:italic;"
                                          t-out="lot.police_opening
                                                 and 'Registre antérieur' or ''"/>
                                    <div t-if="lot._police_piece_identite()"
                                         style="white-space:pre-line;"
                                         t-out="lot._police_piece_identite()"/>
                                    <div t-if="lot.police_origin_id"
                                         style="font-style:italic;"
                                         t-out="lot.police_origin_id.name"/>
                                </td>
                                <td t-att-style="cellule">
                                    <span t-out="lot.product_id.name"/>
                                    <div t-if="lot.police_description"
                                         style="white-space:pre-line;font-style:italic;"
                                         t-out="lot.police_description"/>
                                </td>
                                <td t-att-style="cellule_num">
                                    <span t-out="lot.police_quantity"/></td>
                                <t t-foreach="canaux" t-as="canal">
                                    <t t-set="st" t-value="cellule_num + (
                                            canal in gris and fond_gris or '')"/>
                                    <t t-foreach="['platine', 'or', 'argent']"
                                       t-as="metal">
                                        <td t-att-style="st">
                                            <span t-out="cases['%s/%s'
                                                               % (canal, metal)]"/></td>
                                    </t>
                                </t>
                                <td t-att-style="cellule + fond_gris"/>
                                <td t-att-style="cellule">
                                    <span t-out="lot.police_exit_date"
                                          t-options="{'widget': 'date'}"/></td>
                                <td t-att-style="cellule_pre">
                                    <span t-out="lot._police_observations()"/></td>
                            </tr>
                        </tbody>
                    </table>
                </t>
            </div>
        </t>
    </template>

</odoo>
