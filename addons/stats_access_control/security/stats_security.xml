<odoo>

    <!-- Une catégorie à lui seul, et non un niveau dans une hiérarchie : ce
         droit ne se déduit d'aucun autre — un administrateur des ventes n'a
         pas à lire les chiffres de l'établissement du seul fait qu'il
         paramètre des tarifs.

         Et surtout, pas « Droits supplémentaires » : cette catégorie figure
         dans `res.users._get_hidden_extra_categories()`, et Odoo masque tous
         ses groupes derrière `base.group_no_one`. Le droit n'était visible
         qu'en mode développeur, donc impossible à accorder pour un
         administrateur ordinaire. -->
    <record id="module_category_stats" model="ir.module.category">
        <field name="name">Statistiques</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_global_stats" model="res.groups">
        <field name="name">Statistiques et chiffres consolidés</field>
        <field name="category_id" ref="module_category_stats"/>
        <field name="comment">Donne accès aux écrans d'analyse : ventes par
            vendeur, par client et par article, analyse des factures, rapport
            analytique et tableau de bord de facturation. Les états comptables
            (bilan, grand livre, balances, rapport de taxe) ne dépendent pas de
            ce droit.</field>
    </record>

    <!-- Ventes ▸ Analyse. Le menu porte quatre écrans, dont « Vendeurs » :
         restreindre le parent les couvre tous les quatre. Il était réservé à
         « Ventes / Administrateur », droit que portent aussi les responsables
         de comptoir. -->
    <record id="sale.menu_sale_report" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('group_global_stats')])]"/>
    </record>

    <!-- Et ses quatre enfants, un par un. Masquer le parent les fait
         disparaître de l'arbre affiché, mais eux ne portent aucun groupe :
         leur action reste atteignable par son URL, et « Vendeurs » est
         justement l'écran qu'on voulait fermer. -->
    <record id="sale.menu_reporting_sales" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('group_global_stats')])]"/>
    </record>
    <record id="sale.menu_reporting_salespeople" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('group_global_stats')])]"/>
    </record>
    <record id="sale.menu_reporting_customer" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('group_global_stats')])]"/>
    </record>
    <record id="sale.menu_reporting_product" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('group_global_stats')])]"/>
    </record>

    <!-- Facturation ▸ Gestion ▸ Analyse des factures : le même chiffre, pris
         du côté comptable. Le masquer côté ventes seulement ne masquerait
         rien. -->
    <record id="account.menu_action_account_invoice_report_all" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('group_global_stats')])]"/>
    </record>

    <record id="account.menu_action_analytic_reporting" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('group_global_stats')])]"/>
    </record>

    <!-- Facturation ▸ Tableau de bord : des totaux facturés, en page
         d'accueil. -->
    <record id="account.menu_board_journal_1" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('group_global_stats')])]"/>
    </record>

    <!-- Masquer un menu ne ferme pas l'ecran. `/web/action/load` lit l'action
         en `sudo()`, sans consulter aucun groupe, et le `groups_id` d'une
         fenetre d'action n'est regarde que pour les actions contextuelles
         (`ir.actions.actions.get_bindings`) — jamais au chargement par son
         identifiant. Une URL suffit donc a ouvrir « Analyse des ventes ».

         Ce qui borne ce qu'on y lit, ce sont les regles d'enregistrement. Or
         Odoo les clef sur les groupes de vente : « Documents des autres »
         (`group_sale_salesman_all_leads`) ouvre a lui seul les chiffres
         consolides des trois etablissements. Voir les devis d'un collegue et
         lire le chiffre d'affaires de la maison sont pourtant deux droits
         differents, et c'est tout l'objet de ce module.

         Les deux regles « tout voir » sont donc reattachees a ce droit-ci.
         Sans lui, la regle « les miens » demeure et l'analyse ne montre que
         ses propres lignes — y compris par URL.

         Cela ne peut pas s'ecrire ici : `sale` declare ces deux regles
         `noupdate`, et un `<record>` qui les vise est ignore en silence. Le
         travail se fait donc dans `hooks.py`, appele a l'installation et par
         la migration 18.0.1.2.0. -->

    <!-- ================================================================
         L'autre sens : ouvrir l'analyse du stock a tout le comptoir.

         Inventaire / Analyse porte « Stock » — la liste des articles
         stockables et de leurs quantites, ecran de travail quotidien d'un
         comptoir qui veut savoir ce qu'il a en vitrine. Odoo le reserve a
         « Inventaire / Administrateur », droit qu'un vendeur n'a pas et n'a
         pas a recevoir : il ouvrirait aussi la configuration des entrepots,
         les regles de reassort et les emplacements.

         Le menu parent est donc etendu au simple utilisateur du stock. Ses
         enfants ne portent aucun groupe propre — ils suivent le parent, et
         c'est pour cela qu'il faut regarder ce qu'ils montrent, un par un. -->
    <record id="stock.menu_warehouse_report" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('stock.group_stock_user'),
                                               ref('stock.group_stock_manager')])]"/>
    </record>

    <!-- Sauf Valorisation, qui n'est pas un etat de stock mais un chiffre :
         la valeur en euros de ce que detient l'etablissement. Elle releve du
         meme partage que le chiffre d'affaires.

         Et l'y laisser ne l'aurait meme pas ouverte : `stock.valuation.layer`
         n'est lisible que par « Inventaire / Administrateur ». Le vendeur
         aurait vu un menu qui refuse de s'ouvrir — pire qu'un menu absent. -->
    <record id="stock_account.menu_valuation" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('stock.group_stock_manager')])]"/>
    </record>

</odoo>
