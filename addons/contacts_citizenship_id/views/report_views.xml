<odoo>
    <template id="custom_partner_fields_invoice" inherit_id="web.address_layout">
        <xpath expr="//div[@name='address']/t[1]" position="after">
            <t t-set="lieu_naiss" t-value="o.partner_id.birth_city or o.partner_id.birthplace if (o and o.partner_id) else False"/>
            <t t-set="num_piece" t-value="o.partner_id.id_doc_number or o.partner_id.id_proof if (o and o.partner_id) else False"/>
            <t t-if="o and o.partner_id and not o.partner_id.is_company and (o.partner_id.birthdate or lieu_naiss or num_piece)">
                <div class="custom-information">
                    <t t-if="o.partner_id.birthdate">
                        <p>Date de naissance : <span t-field="o.partner_id.birthdate">10/10/2010</span></p>
                    </t>
                    <t t-if="lieu_naiss">
                        <p>Lieu de naissance : <t t-out="lieu_naiss"/></p>
                    </t>
                    <t t-if="num_piece">
                        <p>Pièce d'identité :
                            <t t-if="o.partner_id.id_doc_type"><span t-field="o.partner_id.id_doc_type"/> </t>
                            n° <t t-out="num_piece"/><t t-if="o.partner_id.id_doc_issue_date">, délivrée le <span t-field="o.partner_id.id_doc_issue_date"/></t><t t-if="o.partner_id.id_doc_issue_place"> à <t t-out="o.partner_id.id_doc_issue_place"/></t><t t-if="o.partner_id.id_doc_authority"> par <t t-out="o.partner_id.id_doc_authority"/></t></p>
                    </t>
                </div>
            </t>
        </xpath>
    </template>
</odoo>