<odoo>
    <record id="view_sale_confirm_wizard_form" model="ir.ui.view">
        <field name="name">sale.confirm.wizard.form</field>
        <field name="model">sale.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirmation">
                <sheet>
                    <!-- IMPORTANT: force field evaluation -->
                    <field name="will_be_refund" invisible="1"/>

                    <!-- INVOICE (GREEN, FLASHY) -->
                    <div
                        class="oe_warning"
                        invisible="not will_be_refund">
                        <h2 style="color: red">
                            Ce devis va être transformé en FACTURE.
                        </h2>
                        <p>Le montant du devis est <strong>POSITIF</strong>, vous allez ici <strong>vendre de la marchandise</strong> au client. Êtes-vous certain ?</p>
                    </div>

                    <!-- CREDIT NOTE (WARNING) -->
                    <div
                        class="oe_success"
                        invisible="will_be_refund">
                        <p>
                            Le montant du devis étant <strong>NEGATIF</strong>, ce devis va être transformé en avoir; vous effectuez ici un rachat au client. Continuer ?
                        </p>
                    </div>

                </sheet>

                <footer>
                    <button
                        name="action_confirm"
                        type="object"
                        string="Confirmer"
                        class="btn-primary"/>
                    <button
                        string="Annuler"
                        special="cancel"
                        class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
