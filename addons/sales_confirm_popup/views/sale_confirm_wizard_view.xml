<odoo>
    <record id="view_sale_confirm_wizard_form" model="ir.ui.view">
        <field name="name">sale.confirm.wizard.form</field>
        <field name="model">sale.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirmation">
                <sheet>
                    <!-- IMPORTANT: force field evaluation -->
                    <field name="sale_order_id" invisible="1"/>
                    <field name="will_be_refund" invisible="1"/>
                    <field name="has_negative_lines" invisible="1"/>
                    <field name="can_choose_zero_total_document" invisible="1"/>

                    <div invisible="not can_choose_zero_total_document">
                        <h2>Ce devis a un total de 0 €.</h2>
                        <p>Il comporte des quantités négatives. Choisissez le document
                            à créer lors de la facturation.</p>
                        <group>
                            <field name="zero_total_document_type" widget="radio"/>
                        </group>
                        <p>Le montant restera à 0 €, quel que soit le choix.</p>
                    </div>

                    <!-- FACTURE (ALERTE) -->
                    <div
                        class="oe_warning"
                        invisible="can_choose_zero_total_document or will_be_refund or has_negative_lines">
                        <h2 style="color: red">
                            Ce devis va être transformé en FACTURE.
                        </h2>
                        <p>Le montant du devis est <strong>POSITIF</strong>, vous allez ici <strong>vendre de la marchandise</strong> au client. Êtes-vous certain ?</p>
                    </div>

                    <!-- FACTURE MALGRE DES QUANTITES NEGATIVES -->
                    <div
                        class="oe_warning"
                        invisible="can_choose_zero_total_document or will_be_refund or not has_negative_lines">
                        <h2 style="color: red">
                            Ce devis va être transformé en FACTURE, et non en avoir.
                        </h2>
                        <p>
                            Il porte des <strong>quantités négatives</strong>, mais son
                            <strong>montant total ne l'est pas</strong> : Odoo ne crée un avoir
                            que sur un montant négatif.
                        </p>
                        <p>
                            S'il s'agit d'un rachat au client, vérifiez le prix avant de
                            confirmer. Continuer ?
                        </p>
                    </div>

                    <!-- AVOIR (RACHAT) -->
                    <div
                        class="oe_success"
                        invisible="can_choose_zero_total_document or not will_be_refund">
                        <p>
                            Le montant du devis étant <strong>NEGATIF</strong>, ce devis va être transformé en avoir; vous effectuez ici un rachat au client. Continuer ?
                        </p>
                    </div>

                </sheet>

                <footer>
                    <button
                        name="action_confirm"
                        type="object"
                        string="Confirmer"
                        class="btn-primary"/>
                    <button
                        string="Annuler"
                        special="cancel"
                        class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
