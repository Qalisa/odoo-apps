<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Factures et avoirs : l'onglet « Lignes de facture ». Voir la note sur
         `active` dans views/sale_order_views.xml. Le champ ne porte aucune
         option en amont (Odoo 18). -->
    <record id="view_move_form_no_inline_product" model="ir.ui.view">
        <field name="name">account.move.form.article.sans.creation.a.la.volee</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']"
                   position="attributes">
                <attribute name="options">{'no_create': True}</attribute>
            </xpath>
        </field>
    </record>

</odoo>
