<odoo>

    <!-- Le registre ne se consulte pas comme une liste de plus. L'arrêté du
         15 mai 2020 (art. 3, 2°) veut que chaque consultation laisse trace de
         « l'identifiant du consultant, la date, l'heure et l'objet ». Cette
         trace n'a de sens que si l'accès est nommément accordé : un droit que
         tout le comptoir porterait ne dirait rien de qui a ouvert le
         registre.

         Le droit ne se déduit d'aucun autre — comptabiliser un avoir n'est
         pas consulter le registre — d'où un droit isolé, et non un niveau de
         plus dans une hiérarchie existante. -->

    <!-- Une catégorie à lui seul, et non « Droits supplémentaires ».

         Odoo masque derrière le mode développeur toute catégorie listée par
         `res.users._get_hidden_extra_categories()` — « Hidden », « Extra » et
         « Usability », c'est-à-dire « Droits supplémentaires ». Le droit y
         était invisible d'un administrateur ordinaire, qui ne pouvait donc
         pas l'accorder : un droit qui commande l'accès à un registre légal ne
         se donne pas depuis un écran caché.

         Il s'affiche désormais dans l'onglet « Droits d'accès » sous son
         propre intitulé. Odoo le rend en liste déroulante plutôt qu'en case à
         cocher — une catégorie qui ne porte qu'un groupe est traitée comme une
         hiérarchie à un seul niveau ; cela se lit de la même façon. -->
    <record id="module_category_livre_police" model="ir.module.category">
        <field name="name">Livre de police</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_livre_police" model="res.groups">
        <field name="name">Livre de police - consultation</field>
        <field name="category_id" ref="module_category_livre_police"/>
        <field name="comment">Donne accès au registre des objets mobiliers et
            des métaux précieux. Le registre est en lecture seule : il s'écrit
            à la comptabilisation des avoirs, et aucun utilisateur ne peut en
            modifier une ligne.</field>
    </record>

    <!-- Un registre par agence, et non un registre pour le groupe.

         « Lorsque les personnes mentionnées à l'article R. 321-1 possèdent
         plusieurs établissements ouverts au public, un registre est tenu pour
         chaque établissement » (c. pén., art. R321-6, en vigueur depuis le
         1er mars 1994). L'article R321-6-1 dispense du registre physique coté
         et paraphé quand la tenue est informatisee — il ne dispense pas de ce
         decoupage-la.

         La numerotation, les pages et leur chainage sont deja propres a
         chaque societe. Manquait la lecture : sans regle d'enregistrement,
         un comptoir ouvrait la liste et y trouvait les vendeurs des deux
         autres — leurs noms, leurs adresses, leurs pieces d'identite. Le
         registre d'un etablissement n'a pas a montrer les clients d'un
         autre. -->
    <record id="regle_societe_ligne" model="ir.rule">
        <field name="name">Livre de police : les inscriptions de la societe</field>
        <field name="model_id" ref="model_livre_police_ligne"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Un transfert appartient aux deux etablissements a la fois : celui
         qui expedie doit le suivre jusqu'a la reception, celui qui recoit
         doit le voir arriver. La regle nomme donc les deux, la ou celle du
         registre n'en nomme qu'un — chaque comptoir ne voit que la moitie
         d'inscription qui est la sienne, et c'est bien ce qu'on veut. -->
    <record id="regle_societe_transfert" model="ir.rule">
        <field name="name">Livre de police : les transferts de la societe</field>
        <field name="model_id" ref="model_livre_police_transfert"/>
        <field name="domain_force">['|', ('company_id', 'in', company_ids),
                                         ('company_destination_id', 'in', company_ids)]</field>
    </record>

    <record id="regle_societe_page" model="ir.rule">
        <field name="name">Livre de police : les pages de la societe</field>
        <field name="model_id" ref="model_livre_police_page"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="regle_societe_consultation" model="ir.rule">
        <field name="name">Livre de police : les consultations de la societe</field>
        <field name="model_id" ref="model_livre_police_consultation"/>
        <!-- Une consultation porte sur plusieurs registres a la fois. Elle se
             montre a qui tient l'un d'eux : sa lecture a bien eu lieu chez
             lui. -->
        <field name="domain_force">['|', ('company_ids', '=', False), ('company_ids', 'in', company_ids)]</field>
    </record>

    <record id="regle_societe_reprise" model="ir.rule">
        <field name="name">Livre de police : les reprises de la societe</field>
        <field name="model_id" ref="model_livre_police_reprise"/>
        <!-- Une reprise ne concerne qu'un coffre : celui de l'etablissement
             dont elle reporte le stock (c. pen., art. R321-6). -->
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
