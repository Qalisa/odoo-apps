<odoo>

    <!--
        Le numéro d'ordre se lit avant la validation, pas après.

        L'opérateur ne saisit pas le lot — il le reçoit. Mais il doit pouvoir
        vérifier, d'un coup d'œil et avant de valider, que le métal posé sur
        la balance est bien celui que le registre a inscrit sous ce numéro. La
        colonne le lui montre ; c'est aussi elle qui rendra lisible le refus
        quand elle sera vide.
    -->
    <record id="stock_picking_view_form_police" model="ir.ui.view">
        <field name="name">stock.picking.form.livre.police</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='product_id']"
                   position="after">
                <field name="police_numero_ordre" string="N° d'ordre"
                       optional="show"
                       column_invisible="parent.picking_type_code != 'incoming'"/>
            </xpath>
        </field>
    </record>

</odoo>
