<odoo>

    <record id="livre_police_provenance_view_list" model="ir.ui.view">
        <field name="name">livre.police.provenance.list</field>
        <field name="model">livre.police.provenance</field>
        <field name="arch" type="xml">
            <list string="Provenances" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="note" optional="show"/>
                <field name="line_count" optional="show"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="livre_police_provenance_view_form" model="ir.ui.view">
        <field name="name">livre.police.provenance.form</field>
        <field name="model">livre.police.provenance</field>
        <field name="arch" type="xml">
            <form string="Provenance">
                <sheet>
                    <widget name="web_ribbon" title="Archivée" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="note"/>
                        <field name="sequence"/>
                        <field name="line_count"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                    <div class="text-muted" invisible="not line_count">
                        Cette provenance figure sur des lignes comptabilisées :
                        son libellé est figé. Pour la retirer de la saisie,
                        décochez « Actif » — les pièces déjà passées gardent
                        la leur (c. pén., art. R321-6 et R321-6-1).
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="livre_police_provenance_action" model="ir.actions.act_window">
        <field name="name">Provenances (livre de police)</field>
        <field name="res_model">livre.police.provenance</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Ajouter une provenance</p>
            <p>
                L'origine déclarée par le vendeur est une mention obligatoire
                du registre (c. pén., art. R321-3 3°). Cette liste est celle
                que le comptoir voit à la saisie.
            </p>
        </field>
    </record>

    <menuitem id="livre_police_provenance_menu"
              name="Provenances (livre de police)"
              parent="sale.menu_sale_config"
              action="livre_police_provenance_action"
              sequence="95"/>

</odoo>
