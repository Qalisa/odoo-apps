<odoo>

    <!-- La liste suit l'ordre du modèle officiel (arrêté du 15 mai 2020,
         annexe I) : numéro d'ordre, date, description et provenance, vendeur,
         pièce d'identité, prix et règlement, protection au titre du code du
         patrimoine. Un contrôleur arrive avec ce formulaire en tête ; l'écran
         doit se lire dans le même ordre que lui.

         Viennent ensuite, et seulement ensuite, les mentions que le registre
         des métaux ajoute (CGI, ann. IV, art. 56 J quindecies) : elles ne
         s'intercalent pas dans un modèle qui ne les prévoit pas. -->
    <record id="livre_police_ligne_view_list" model="ir.ui.view">
        <field name="name">livre.police.ligne.list</field>
        <field name="model">livre.police.ligne</field>
        <field name="arch" type="xml">
            <list string="Livre de police" create="false" edit="false"
                  delete="false" default_order="company_id, numero_ordre"
                  decoration-muted="rectifiee"
                  class="o_livre_police_liste">
                <field name="rectifiee" column_invisible="1"/>
                <!-- La societe precede le numero d'ordre parce qu'elle le
                     qualifie : un registre est tenu pour chaque etablissement
                     (c. pen., art. R321-6), et chaque agence repart donc de
                     000001. « Metz 000004 » et « Nancy 000004 » sont deux
                     inscriptions differentes. Ce n'est pas une colonne de
                     l'annexe I — celle-ci commence au numero d'ordre — mais
                     l'identite du registre dans lequel on lit. -->
                <field name="company_id" optional="show"
                       groups="base.group_multi_company"/>
                <field name="numero_ordre"/>
                <field name="sens" optional="show"/>
                <field name="etat_sortie" optional="show"
                       decoration-success="etat_sortie == 'sorti'"
                       decoration-warning="etat_sortie == 'partiel'"/>
                <field name="entree_id" optional="show" string="Sort de"/>
                <!-- Le comptoir qui a rachete, quel que soit celui qui
                     detient le metal aujourd'hui. Sur un rachat local, elle
                     redit la societe ; apres un transfert, elle est la seule
                     colonne qui remonte a l'achat. -->
                <field name="origine_etablissement" optional="hide"/>
                <field name="origine_numero_ordre" optional="show"/>
                <field name="numero_lot" optional="hide"/>
                <field name="transfert_id" optional="hide"/>
                <field name="transfert_etablissement" optional="show"/>
                <field name="rectifie_id" optional="show"
                       string="Rectifie"/>
                <field name="date_achat"/>
                <field name="designation"/>
                <field name="description" class="o_lp_description"/>
                <field name="provenance"/>
                <field name="contrepartie_nom"/>
                <field name="contrepartie_qualite" optional="show"/>
                <field name="contrepartie_domicile" optional="hide"/>
                <!--
                    La colonne du registre lui-meme, telle qu'elle est
                    inscrite et telle que l'edition quotidienne l'imprime.
                    Masquee par defaut : elle est vide sur une sortie, ce que
                    la colonne ci-dessus corrige a l'ecran.
                -->
                <field name="vendeur_nom" optional="hide"/>
                <field name="representant_nom" optional="show"/>
                <field name="representant_qualite" optional="hide"/>
                <field name="piece_nature" optional="show"/>
                <field name="piece_numero" optional="show"/>
                <field name="piece_autorite" optional="hide"/>
                <field name="piece_delivrance" optional="hide"/>
                <field name="prix_texte"/>
                <field name="prix" sum="Total" optional="hide"
                       invisible="sens != 'entree'"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="mode_reglement" optional="show"/>
                <field name="protection_patrimoine" optional="hide"/>
                <field name="metal_nature" optional="show"/>
                <field name="quantite" optional="hide"/>
                <field name="regime_quantite" optional="hide"/>
                <field name="poids" sum="Poids total" optional="show"/>
                <field name="titre_texte" optional="show"/>
                <field name="date_mouvement" optional="hide"/>
                <field name="poids_restant" optional="hide"/>
                <field name="date_sortie" optional="show"/>
                <field name="transfert_motif" optional="hide"/>
                <field name="reprise_id" optional="hide"/>
                <field name="reprise_registre_papier" optional="hide"/>
                <field name="motif_rectification" optional="hide"/>
                <field name="move_id" optional="hide"/>
                <field name="facture_vente_ids" optional="hide"
                       widget="many2many_tags" string="Facture de vente"/>
            </list>
        </field>
    </record>

    <!-- La fiche existe pour lire une inscription en entier, jamais pour la
         reprendre. Le bouton « Rectifier » viendra avec la rectification par
         nouvel enregistrement motivé ; d'ici là, rien ne s'écrit ici. -->
    <record id="livre_police_ligne_view_form" model="ir.ui.view">
        <field name="name">livre.police.ligne.form</field>
        <field name="model">livre.police.ligne</field>
        <field name="arch" type="xml">
            <form string="Inscription au registre" create="false" edit="false">
                <header>
                    <button name="action_rectifier" type="object"
                            string="Rectifier" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="alert alert-warning mb-3" role="alert"
                         invisible="not rectifiee">
                        Cette inscription a été rectifiée. Elle demeure au
                        registre telle qu'elle a été écrite ; la correction
                        s'y trouve sous un numéro d'ordre postérieur.
                        <field name="rectifiee_par_ids" nolabel="1"
                               readonly="1" widget="many2many_tags"/>
                    </div>
                    <field name="rectifiee" invisible="1"/>
                    <div class="oe_title">
                        <label for="numero_ordre" string="N° d'ordre"/>
                        <h1><field name="numero_ordre" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="L'opération">
                            <field name="sens" readonly="1"/>
                            <field name="entree_id" readonly="1"
                                   invisible="sens != 'sortie'"/>
                            <!-- Une entree recue d'un autre etablissement
                                 a, elle aussi, un mouvement de stock et une
                                 date d'arrivee : c'est une entree qui vient
                                 du stock et non d'un avoir. -->
                            <field name="mouvement_stock_id" readonly="1"
                                   invisible="sens != 'sortie' and not transfert_id"/>
                            <field name="date_mouvement" readonly="1"
                                   invisible="sens != 'sortie' and not transfert_id"/>
                            <field name="date_achat" readonly="1"
                                   invisible="sens != 'entree'"/>
                            <field name="prix_texte" readonly="1"
                                   invisible="sens != 'entree'"
                                   placeholder="sans objet"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="mode_reglement" readonly="1"
                                   invisible="sens != 'entree'"
                                   placeholder="renseigné au règlement"/>
                            <field name="company_id" readonly="1"
                                   groups="base.group_multi_company"/>
                            <field name="move_id" readonly="1"
                                   invisible="sens != 'entree'"/>
                        </group>
                        <group string="Les objets">
                            <field name="metal_nature" readonly="1"/>
                            <field name="quantite" readonly="1"/>
                            <field name="regime_quantite" readonly="1"/>
                            <field name="poids" readonly="1"/>
                            <field name="titre_texte" readonly="1"/>
                            <field name="etat_sortie" readonly="1"
                                   invisible="sens != 'entree'"/>
                            <field name="date_sortie" readonly="1"
                                   invisible="sens != 'entree'"
                                   placeholder="encore en stock"/>
                        </group>
                    </group>
                    <!--
                        Le recapitulatif des sorties. Une entree ne dit pas
                        d'elle-meme ce qu'elle est devenue : les departs sont
                        des inscriptions separees, ailleurs dans la suite. Les
                        rassembler ici evite de les chercher, et repond a la
                        seule question qu'on se pose devant un numero d'ordre —
                        en reste-t-il, et combien.
                    -->
                    <group string="Ce qui est sorti" invisible="sens != 'entree'">
                        <group>
                            <field name="poids_sorti" readonly="1"/>
                            <field name="poids_restant" readonly="1"/>
                        </group>
                    </group>
                    <field name="sortie_ids" readonly="1" nolabel="1"
                           invisible="sens != 'entree' or not sortie_ids">
                        <list create="false" edit="false" delete="false"
                              default_order="numero_ordre">
                            <field name="numero_ordre" string="N° d'ordre"/>
                            <field name="date_mouvement" string="Sortie le"/>
                            <field name="quantite"/>
                            <field name="regime_quantite" string="Régime"/>
                            <field name="poids" sum="Poids sorti"/>
                        </list>
                    </field>
                    <group string="Description et provenance"
                           invisible="sens != 'entree'">
                        <field name="designation" readonly="1"/>
                        <field name="description" readonly="1" nolabel="1"
                               colspan="2"/>
                        <field name="provenance" readonly="1"/>
                        <field name="protection_patrimoine" readonly="1"
                               invisible="not protection_patrimoine"/>
                    </group>
                    <!--
                        La facture de vente n'est une mention d'aucun des deux
                        registres — ni le prix de revente ni l'acheteur n'y
                        figurent. Elle dit ou retrouver la piece justificative,
                        que le I de l'art. L102 B du LPF fait conserver : elle
                        doit donc se cliquer, ce qu'une etiquette ne fait pas.
                    -->
                    <group string="La facture de vente"
                           invisible="sens != 'sortie'">
                        <field name="facture_vente_ids" readonly="1" nolabel="1"
                               colspan="2">
                            <list create="false" edit="false" delete="false">
                                <field name="name"/>
                                <field name="invoice_date"/>
                                <field name="partner_id"/>
                                <field name="currency_id" column_invisible="1"/>
                                <field name="amount_total"/>
                            </list>
                        </field>
                    </group>
                    <group string="Description" invisible="sens != 'sortie'">
                        <field name="description" readonly="1" nolabel="1"
                               colspan="2"/>
                    </group>
                    <!--
                        Une sortie n'a ni vendeur ni piece d'identite, et ce
                        n'est pas un oubli : `_valeurs_depuis_sortie` ne
                        recopie de l'entree que ce qui decrit la marchandise.
                        Les repeter laisserait croire qu'une seconde
                        operation a eu lieu avec la meme personne. Le champ
                        « Sort de » mene a l'entree qui les porte.
                    -->
                    <group invisible="sens != 'entree'">
                        <group string="Le vendeur">
                            <field name="vendeur_nom" readonly="1"/>
                            <field name="vendeur_qualite" readonly="1"/>
                            <field name="vendeur_domicile" readonly="1"/>
                            <field name="representant_nom" readonly="1"
                                   invisible="not representant_nom"/>
                            <field name="representant_qualite" readonly="1"
                                   invisible="not representant_nom"/>
                        </group>
                        <group string="La pièce d'identité présentée">
                            <field name="piece_nature" readonly="1"/>
                            <field name="piece_numero" readonly="1"/>
                            <field name="piece_autorite" readonly="1"/>
                            <field name="piece_delivrance" readonly="1"/>
                        </group>
                    </group>
                    <!--
                        Le metal recu d'un autre etablissement. La colonne du
                        vendeur reste vide : personne n'a vendu. Ce qui tient
                        sa place, c'est l'origine, et le motif qui dit
                        pourquoi le metal a bouge.
                    -->
                    <group string="Transfert entre établissements"
                           invisible="not transfert_id">
                        <group>
                            <field name="transfert_id" readonly="1"/>
                            <field name="transfert_etablissement" readonly="1"/>
                        </group>
                        <group>
                            <field name="transfert_motif" readonly="1"/>
                        </group>
                    </group>
                    <group string="L'origine du métal"
                           invisible="not origine_numero_ordre">
                        <group>
                            <field name="origine_etablissement" readonly="1"/>
                            <field name="origine_numero_ordre" readonly="1"/>
                        </group>
                        <group>
                            <field name="origine_date_achat" readonly="1"/>
                            <field name="numero_lot" readonly="1"/>
                            <!-- Le lien ne s'ouvre que depuis l'etablissement
                                 qui tient ce registre-la : les trois colonnes
                                 ci-dessus en portent la copie, lisible
                                 partout. -->
                            <field name="origine_id" readonly="1"
                                   invisible="not origine_id"/>
                        </group>
                    </group>
                    <group string="Reprise de stock d'ouverture"
                           invisible="not reprise_id">
                        <group>
                            <field name="reprise_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="reprise_registre_papier" readonly="1"/>
                        </group>
                    </group>
                    <group string="Rectification"
                           invisible="not rectifie_id">
                        <field name="rectifie_id" readonly="1"/>
                        <field name="motif_rectification" readonly="1"/>
                    </group>
                    <group string="Inscription">
                        <field name="date_inscription" readonly="1"/>
                        <field name="inscrit_par_id" readonly="1"/>
                        <field name="move_line_id" readonly="1"
                               invisible="sens != 'entree'"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="livre_police_ligne_view_search" model="ir.ui.view">
        <field name="name">livre.police.ligne.search</field>
        <field name="model">livre.police.ligne</field>
        <field name="arch" type="xml">
            <search string="Livre de police">
                <field name="numero_ordre"
                       filter_domain="['|', '|',
                                       ('numero_ordre', 'ilike', self),
                                       ('numero_lot', 'ilike', self),
                                       ('origine_numero_ordre', 'ilike', self)]"
                       string="N° d'ordre ou lot"/>
                <field name="vendeur_nom"
                       filter_domain="['|', ('vendeur_nom', 'ilike', self),
                                            ('representant_nom', 'ilike', self)]"
                       string="Vendeur ou représentant"/>
                <field name="designation"/>
                <field name="description"/>
                <field name="metal_nature"/>
                <field name="move_id"/>
                <filter name="filtre_aujourdhui" string="Aujourd'hui"
                        domain="[('date_achat', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <!-- Le métal entré et jamais ressorti : la colonne « date de
                     sortie » du registre des métaux, tant qu'elle est vide. -->
                <filter name="filtre_sans_sortie" string="Encore en stock"
                        domain="[('sens', '=', 'entree'), ('sortie_ids', '=', False)]"/>
                <separator/>
                <filter name="filtre_entrees" string="Entrées"
                        domain="[('sens', '=', 'entree')]"/>
                <filter name="filtre_sorties" string="Sorties"
                        domain="[('sens', '=', 'sortie')]"/>
                <separator/>
                <filter name="filtre_partiels" string="Sortis en partie"
                        domain="[('etat_sortie', '=', 'partiel')]"/>
                <filter name="filtre_soldes" string="Entièrement sortis"
                        domain="[('etat_sortie', '=', 'sorti')]"/>
                <separator/>
                <filter name="filtre_reprises"
                        string="Reprises de stock d'ouverture"
                        domain="[('reprise_id', '!=', False)]"/>
                <filter name="filtre_transferts"
                        string="Transferts entre établissements"
                        domain="[('transfert_id', '!=', False)]"/>
                <separator/>
                <filter name="filtre_rectifications" string="Rectifications"
                        domain="[('rectifie_id', '!=', False)]"/>
                <filter name="filtre_rectifiees" string="Inscriptions rectifiées"
                        domain="[('rectifiee', '=', True)]"/>
                <separator/>
                <filter name="filtre_annee" string="Cette année"
                        domain="[('date_achat', '&gt;=',
                                  (context_today() + relativedelta(month=1, day=1)).strftime('%Y-%m-%d'))]"/>
                <!-- Pas de regroupement par etat de sortie : `etat_sortie`
                     se calcule a la lecture et n'existe pas en base, quand un
                     group_by demande du SQL. Odoo levait « Cannot convert
                     livre.police.ligne.etat_sortie to SQL because it is not
                     stored » et l'ecran repondait « Oups ! ». Les deux filtres
                     ci-dessus passent, eux, par `_search_etat_sortie`. -->
                <group expand="0" string="Regrouper par">
                    <filter name="groupe_jour" string="Jour de l'achat"
                            context="{'group_by': 'date_achat:day'}"/>
                    <filter name="groupe_societe" string="Société"
                            context="{'group_by': 'company_id'}"/>
                    <filter name="groupe_sens" string="Sens"
                            context="{'group_by': 'sens'}"/>
                    <filter name="groupe_nature" string="Nature du métal"
                            context="{'group_by': 'metal_nature'}"/>
                    <filter name="groupe_provenance" string="Provenance"
                            context="{'group_by': 'provenance'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="livre_police_ligne_action" model="ir.actions.act_window">
        <field name="name">Livre de police</field>
        <field name="res_model">livre.police.ligne</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'group_by': 'date_achat:day'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Le registre est vide</p>
            <p>
                Une ligne s'y inscrit à la comptabilisation de chaque avoir de
                rachat, pour chaque lot d'objets entré. Rien ne s'y saisit à
                la main.
            </p>
        </field>
    </record>

    <!-- Menu racine, et non un écran de plus sous Comptabilité : le registre
         relève d'une obligation distincte, son accès est nommément accordé,
         et l'entrée dans ce menu est ce qu'il faudra tracer. -->
    <menuitem id="livre_police_menu_racine"
              name="Livre de police"
              groups="fr_livre_police_metaux.group_livre_police"
              sequence="70"/>

    <!-- L'action vit ici, avec le menu qui l'appelle : sa vue est définie
         avec le journal des consultations, qui est ce qu'elle alimente. -->
    <record id="livre_police_acces_action" model="ir.actions.act_window">
        <field name="name">Livre de police</field>
        <field name="res_model">livre.police.acces</field>
        <field name="view_mode">form</field>
        <!-- « current » explicitement : retirer le champ du XML ne remet pas
             la valeur deja enregistree, et l'action naissait en « new ». -->
        <field name="target">current</field>
    </record>

    <!--
        Le menu ouvre la déclaration, pas la liste : l'objet de la consultation
        doit être enregistré avant qu'on lise quoi que ce soit (arrêté du
        15 mai 2020, art. 3, 2°). L'action de la liste reste, c'est elle que
        la déclaration renvoie une fois la trace écrite.

        La déclaration est une page pleine, et non une fenêtre modale : on
        entre d'abord dans l'application, on y trouve un bouton qui ouvre le
        registre. Une modale s'ouvrait par-dessus le module précédent, et le
        registre venait ensuite se poser au bout de son fil d'Ariane.
    -->
    <menuitem id="livre_police_ligne_menu"
              name="Registre"
              parent="livre_police_menu_racine"
              action="livre_police_acces_action"
              sequence="10"/>

</odoo>
