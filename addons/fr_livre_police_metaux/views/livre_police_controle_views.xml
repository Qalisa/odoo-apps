<odoo>

    <record id="livre_police_controle_view_form" model="ir.ui.view">
        <field name="name">livre.police.controle.form</field>
        <field name="model">livre.police.controle</field>
        <field name="arch" type="xml">
            <form string="Contrôle d'intégrité du registre">
                <div class="alert alert-info mb-3" role="alert">
                    Le contrôle recalcule le chiffre de contrôle de chaque page
                    à partir de son contenu actuel et le compare à celui qui a
                    été scellé, vérifie que chaque page reprend bien le
                    contrôle de la précédente, et relève les numéros manquants.
                    Le résultat s'imprime : c'est ce document qui fait preuve.
                </div>
                <group>
                    <field name="company_id"
                           groups="base.group_multi_company"/>
                    <field name="date_debut"/>
                    <field name="date_fin"/>
                </group>
                <footer>
                    <button string="Contrôler et imprimer" type="object"
                            name="action_controler" class="btn-primary"/>
                    <button string="Annuler" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="livre_police_controle_action" model="ir.actions.act_window">
        <field name="name">Contrôle d'intégrité</field>
        <field name="res_model">livre.police.controle</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="livre_police_controle_menu"
              name="Contrôle d'intégrité"
              parent="livre_police_menu_racine"
              action="livre_police_controle_action"
              sequence="30"/>

</odoo>
