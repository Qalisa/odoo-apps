<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="livre_police_correction_piece_view_form" model="ir.ui.view">
        <field name="name">livre.police.correction.piece.form</field>
        <field name="model">livre.police.correction.piece</field>
        <field name="arch" type="xml">
            <form string="Corriger cette pièce">
                <field name="move_id" invisible="1"/>
                <field name="inscription_ids" invisible="1"/>
                <field name="plusieurs_inscriptions" invisible="1"/>
                <group>
                    <field name="nature" widget="radio"/>
                    <field name="ligne_id"
                           invisible="nature in ('titre', 'annulation') or not plusieurs_inscriptions"
                           options="{'no_create': True, 'no_open': True}"/>
                </group>
                <div class="alert alert-warning" role="status">
                    <field name="consequences" nolabel="1"/>
                </div>
                <group invisible="nature != 'annulation'">
                    <field name="annuler_reglement"/>
                    <field name="motif" colspan="2"
                           required="nature == 'annulation'"
                           placeholder="Ce qui a été constaté, et pourquoi l'opération est annulée."/>
                </group>
                <footer>
                    <button string="Continuer" type="object"
                            name="action_continuer" class="btn-primary"
                            invisible="nature == 'annulation'"/>
                    <button string="Annuler l'opération" type="object"
                            name="action_continuer" class="btn-danger"
                            invisible="nature != 'annulation'"
                            confirm="Les inscriptions seront rectifiées à zéro et une contre-pièce sera comptabilisée. Continuer ?"/>
                    <button string="Fermer" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_move_form_police_corriger" model="ir.ui.view">
        <field name="name">account.move.form.police.corriger</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Le retour au brouillon est refusé sur une pièce inscrite ;
                 c'est d'ici que part la correction. -->
            <xpath expr="//header" position="inside">
                <field name="police_corrigeable" invisible="1"/>
                <button name="action_police_corriger" type="object"
                        string="Corriger cette pièce" class="btn-danger"
                        invisible="not police_corrigeable"
                        groups="fr_livre_police_metaux.group_livre_police"/>
            </xpath>
        </field>
    </record>

</odoo>
