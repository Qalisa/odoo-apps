<odoo>

    <!--
        Le choix du lot se fait dans cette liste déroulante, et nulle part
        ailleurs. Une colonne de plus y met les objets sous les yeux, à
        côté du numéro d'ordre qui, seul, ne distingue rien.

        Sur une réception, la colonne n'a rien à dire : le lot n'existe pas
        encore, et sa description naîtra avec lui.
    -->
    <record id="stock_move_line_operations_police" model="ir.ui.view">
        <field name="name">stock.move.line.operations.list.livre.police</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <!--
                L'ordre est celui de la question qu'on se pose : d'ou sort le
                metal, de quel achat, quand, aupres de qui, puis ce que c'est
                — l'article, les objets — et seulement alors les nombres.
                « Produit » est deplace pour cela : Odoo le pose en tete, ou
                il precede la provenance.
            -->
            <xpath expr="//field[@name='quant_id']" position="after">
                <field name="police_avoir_id" string="Avoir d'achat"
                       optional="show" readonly="1"
                       column_invisible="context.get('picking_code') == 'incoming'"/>
                <field name="police_avoir_date" string="Date de l'avoir"
                       optional="show" readonly="1"
                       column_invisible="context.get('picking_code') == 'incoming'"/>
                <field name="police_vendeur_id" string="Vendeur"
                       optional="show" readonly="1"
                       column_invisible="context.get('picking_code') == 'incoming'"/>
                <xpath expr="//field[@name='product_id']" position="move"/>
                <field name="police_description" string="Objets"
                       optional="show" readonly="1"
                       column_invisible="context.get('picking_code') == 'incoming'"/>
            </xpath>
            <xpath expr="//field[@name='quantity']" position="before">
                <field name="police_quant_detenu" string="Détenu"
                       optional="show" readonly="1"
                       column_invisible="context.get('picking_code') == 'incoming'"/>
            </xpath>
            <!--
                Rouge des que la saisie depasse le detenu, comme le formulaire
                du bon colore une quantite qui depasse la demande. Le refus
                tombera de toute facon a l'enregistrement ; autant que la
                ligne le dise avant qu'on la quitte.
            -->
            <xpath expr="//field[@name='quantity']" position="attributes">
                <attribute name="decoration-danger">police_quant_detenu and quantity &gt; police_quant_detenu</attribute>
            </xpath>
            <xpath expr="//field[@name='quantity']" position="after">
                <field name="police_poids" string="Poids (g)"
                       optional="show" readonly="1" sum="Poids"/>
            </xpath>
        </field>
    </record>

    <!--
        Et sur la fiche du lot, la pièce qui l'a fait entrer. La description
        y figure déjà, dans l'onglet qu'Odoo lui réserve ; l'avoir manquait.
    -->
    <record id="stock_lot_view_form_police" model="ir.ui.view">
        <field name="name">stock.lot.form.livre.police</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="police_avoir_id" invisible="not police_avoir_id"/>
                <field name="police_vendeur_id" invisible="not police_vendeur_id"/>
            </xpath>
        </field>
    </record>

    <record id="stock_lot_view_tree_police" model="ir.ui.view">
        <field name="name">stock.lot.list.livre.police</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="police_description" string="Objets"
                       optional="show" readonly="1"/>
                <field name="police_avoir_id" string="Avoir d'achat"
                       optional="show" readonly="1"/>
                <field name="police_vendeur_id" string="Vendeur"
                       optional="hide" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!--
        Et la regle qui decide de ce que cette liste contient.

        Odoo y applique « In Stock » par defaut — `quantity > 0`, la presence
        physique. Un lot entierement reserve par un autre bon y figure donc au
        meme titre qu'un lot intact : on le choisit, la ligne naît a zero, et
        il reste offert au clic suivant. Le critere juste est ce qui reste
        libre.

        Le filtre est renomme avec son domaine — « En stock » ne dirait plus
        ce qu'il fait. Celui d'origine reste disponible sous son propre nom :
        savoir ce qu'on detient physiquement est une autre question, et elle
        se pose aussi.

        `search_default_in_stock` n'est ecrit qu'a un seul endroit dans tout
        Odoo — le composant qui ouvre « Ajouter une ligne ». Changer ce filtre
        ne change donc le defaut de personne d'autre.
    -->
    <record id="stock_quant_view_search_police" model="ir.ui.view">
        <field name="name">stock.quant.search.livre.police</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.quant_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='in_stock']" position="attributes">
                <attribute name="string">Disponible</attribute>
                <attribute name="domain">[('available_quantity', '&gt;', 0.0)]</attribute>
            </xpath>
            <xpath expr="//filter[@name='in_stock']" position="after">
                <filter name="police_present" string="Présent en stock"
                        domain="[('quantity', '&gt;', 0.0)]"/>
            </xpath>
        </field>
    </record>

    <!--
        Le meme besoin, une ligne plus loin : « Ajouter une ligne » ouvre la
        liste des quants, et c'est encore un tableau ou l'on choisit — le
        premier, meme, puisque c'est la que le lot se decide.

        Meme ordre que dans les tableaux du bon : de quel achat, quand,
        aupres de qui, puis ce que c'est, et seulement alors les nombres.
        Les deux colonnes chiffrees gardent les noms d'Odoo — « En stock » et
        « Disponible » ne disent pas la meme chose que « Detenu » et
        « Quantite », et les renommer ici ferait croire le contraire.
    -->
    <record id="stock_quant_view_tree_simple_police" model="ir.ui.view">
        <field name="name">stock.quant.list.livre.police</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_simple"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lot_id']" position="after">
                <field name="police_avoir_id" string="Avoir d'achat" readonly="1"/>
                <field name="police_avoir_date" string="Date de l'avoir"
                       readonly="1"/>
                <field name="police_vendeur_id" string="Vendeur" readonly="1"/>
                <!--
                    Odoo pose « Produit » en tete, avant la provenance. Il
                    reste masque quand le tableau ne porte qu'un article
                    — c'est le cas depuis « Ajouter une ligne » — mais il
                    tombe alors au bon endroit partout ailleurs.
                -->
                <xpath expr="//field[@name='product_id']" position="move"/>
                <field name="police_description" string="Objets" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='available_quantity']" position="after">
                <field name="police_poids" string="Poids (g)" readonly="1"
                       sum="Poids"/>
            </xpath>
        </field>
    </record>

    <!--
        Le bouton ☰ d'une ligne de transfert ouvre un autre tableau, avec sa
        propre liste : le même besoin s'y pose.

        Les colonnes suivent `show_quant`, comme « Enlever parmi » : elles
        apparaissent exactement quand on choisit d'où sortir, et se taisent
        sur une réception.
    -->
    <record id="stock_move_line_operation_police" model="ir.ui.view">
        <field name="name">stock.move.line.operations.list.mouvement.livre.police</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
            <!--
                Le numero d'ordre est ce qu'on vient lire ici : il lui faut
                sa largeur, que les colonnes ajoutees lui prenaient.
            -->
            <xpath expr="//field[@name='quant_id']" position="attributes">
                <attribute name="width">210px</attribute>
            </xpath>
            <!--
                Meme ordre qu'au detail des operations. « Produit » n'y est
                pas deplace : Odoo le pose ici en `column_invisible="True"`,
                l'article etant deja nomme dans l'en-tete du mouvement.
            -->
            <xpath expr="//field[@name='quant_id']" position="after">
                <field name="police_avoir_id" string="Avoir d'achat"
                       optional="show" readonly="1" width="140px"
                       column_invisible="not parent.show_quant"/>
                <field name="police_avoir_date" string="Date de l'avoir"
                       optional="show" readonly="1" width="110px"
                       column_invisible="not parent.show_quant"/>
                <field name="police_vendeur_id" string="Vendeur"
                       optional="show" readonly="1" width="130px"
                       column_invisible="not parent.show_quant"/>
                <field name="police_description" string="Objets"
                       optional="show" readonly="1" width="200px"
                       column_invisible="not parent.show_quant"/>
            </xpath>
            <!--
                Et ce que le lot contient, juste avant la quantite qu'on
                saisit : sans lui, on saisit a l'aveugle.
            -->
            <xpath expr="//field[@name='quantity']" position="before">
                <field name="police_quant_detenu" string="Détenu"
                       optional="show" readonly="1" width="90px"
                       column_invisible="not parent.show_quant"/>
            </xpath>
            <xpath expr="//field[@name='quantity']" position="attributes">
                <attribute name="decoration-danger">police_quant_detenu and quantity &gt; police_quant_detenu</attribute>
            </xpath>
            <!--
                Le poids se lit a cote de la quantite, jamais a sa place :
                sur une piece les deux different, et c'est le poids que le
                registre des metaux reclame (CGI, ann. IV, art. 56 J
                quindecies).
            -->
            <xpath expr="//field[@name='quantity']" position="after">
                <field name="police_poids" string="Poids (g)"
                       optional="show" readonly="1" sum="Poids"/>
            </xpath>
        </field>
    </record>

</odoo>
