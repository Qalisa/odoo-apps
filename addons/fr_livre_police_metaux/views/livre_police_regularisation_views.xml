<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="livre_police_regularisation_view_form" model="ir.ui.view">
        <field name="name">livre.police.regularisation.form</field>
        <field name="model">livre.police.regularisation</field>
        <field name="arch" type="xml">
            <form string="Régulariser une arrivée">
                <div class="alert alert-info" role="status">
                    Le métal est parti d'un comptoir sans emprunter le document
                    de transfert : sa sortie s'est inscrite là-bas, son entrée
                    nulle part. Cet écran inscrit l'entrée manquante et fait
                    entrer le métal en stock.
                    <br/>
                    Il ne touche pas au registre de départ : la sortie y est
                    vraie. Ce qui lui manque — dire où le métal est allé — se
                    rectifie de son côté.
                </div>
                <group>
                    <group string="Ce qui est sorti de l'autre comptoir">
                        <field name="sortie_id"
                               options="{'no_create': True}"/>
                        <field name="etablissement_depart"/>
                        <field name="designation"/>
                        <field name="quantite_sortie"/>
                        <field name="date_sortie"/>
                    </group>
                    <group string="Ce qui est arrivé ici">
                        <field name="company_id"
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="quantite"/>
                    </group>
                </group>
                <group string="Pourquoi cette entrée s'inscrit après coup">
                    <field name="motif" nolabel="1" colspan="2"
                           placeholder="Le document de transfert n'a pas été employé : dites ce qui s'est passé."/>
                </group>
                <footer>
                    <button string="Inscrire l'entrée" type="object"
                            name="action_inscrire" class="btn-primary"/>
                    <button string="Annuler" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_regulariser_une_arrivee" model="ir.actions.act_window">
        <field name="name">Régulariser une arrivée</field>
        <field name="res_model">livre.police.regularisation</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_livre_police_ligne"/>
        <field name="binding_view_types">list,form</field>
        <field name="context">{'default_sortie_id': active_id}</field>
        <field name="groups_id" eval="[(4, ref('fr_livre_police_metaux.group_livre_police'))]"/>
    </record>

</odoo>
