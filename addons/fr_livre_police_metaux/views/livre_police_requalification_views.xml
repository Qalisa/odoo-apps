<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="livre_police_requalification_view_form" model="ir.ui.view">
        <field name="name">livre.police.requalification.form</field>
        <field name="model">livre.police.requalification</field>
        <field name="arch" type="xml">
            <form string="Requalifier des parts de lots">
                <div class="alert alert-info" role="status">
                    Le tri révèle qu'une part de ces lots n'est pas de la
                    nature sous laquelle elle a été inscrite. Rien n'entre,
                    rien ne sort : ce métal était déjà là, sous d'autres noms.
                    <br/>
                    Chaque inscription d'origine se réduit de ce qu'on lui
                    retire, par une rectification portant le motif ; ce qui
                    sort du tri forme <b>un seul lot</b>, sous son propre
                    numéro d'ordre, donc sa propre étiquette. Sa date d'entrée
                    est celle du plus récent des rachats, et la provenance les
                    nomme tous.
                </div>
                <field name="ligne_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0">
                        <field name="numero_ordre" readonly="1"/>
                        <field name="designation" readonly="1"/>
                        <field name="date_achat" readonly="1"/>
                        <field name="quantite_inscrite" readonly="1"/>
                        <field name="poids_inscrit" readonly="1"
                               optional="show"/>
                        <field name="quantite_retiree"/>
                        <field name="poids_retire" readonly="1"/>
                        <field name="prelevee" column_invisible="True"/>
                    </list>
                </field>
                <group>
                    <group string="Ce que ces parts sont réellement">
                        <field name="product_id"
                               options="{'no_create': True}"/>
                        <field name="quantite"/>
                        <field name="poids"/>
                        <field name="description"/>
                    </group>
                    <group string="Ce que le tri a ôté aux lots">
                        <field name="poids_retire_total"/>
                    </group>
                </group>
                <group string="Ce que le tri a constaté">
                    <field name="motif" nolabel="1" colspan="2"
                           placeholder="Ce qui a été trié, et ce qui a été reconnu."/>
                </group>
                <footer>
                    <button string="Inscrire la requalification" type="object"
                            name="action_requalifier" class="btn-primary"/>
                    <button string="Annuler" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- L'ecran s'ouvre sur une selection : le tri sort l'or blanc de
         plusieurs rachats a la fois, et ces inscriptions se designent
         ensemble depuis la liste du registre. Depuis un formulaire, la
         selection vaut un seul lot — c'est le meme ecran, a une ligne. -->
    <record id="action_requalifier_une_part" model="ir.actions.act_window">
        <field name="name">Requalifier des parts de lots</field>
        <field name="res_model">livre.police.requalification</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_livre_police_ligne"/>
        <field name="binding_view_types">list,form</field>
        <field name="groups_id" eval="[(4, ref('fr_livre_police_metaux.group_livre_police'))]"/>
    </record>

</odoo>
