<odoo>

    <record id="livre_police_rectification_view_form" model="ir.ui.view">
        <field name="name">livre.police.rectification.form</field>
        <field name="model">livre.police.rectification</field>
        <field name="arch" type="xml">
            <form string="Rectifier une inscription">
                <!--
                    L'assistant part des valeurs d'origine : une rectification
                    ne corrige presque jamais tout, et recopier à la main les
                    mentions justes serait une occasion d'en fausser une
                    seconde.
                -->
                <div class="alert alert-info mb-3" role="alert">
                    L'inscription <field name="numero_ordre_origine"
                    class="fw-bold" readonly="1" nolabel="1"/> ne sera pas
                    modifiée : elle reste au registre telle qu'elle a été
                    écrite. La correction s'inscrit à la suite, sous un
                    nouveau numéro d'ordre, et renvoie à elle.
                </div>
                <field name="ligne_id" invisible="1"/>
                <group>
                    <field name="motif" required="1" colspan="2"
                           placeholder="Qu'a-t-on constaté, et pourquoi l'inscription devait-elle être corrigée ?"/>
                </group>
                <group>
                    <group string="L'opération">
                        <field name="date_achat"/>
                        <field name="prix"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="mode_reglement"/>
                    </group>
                    <group string="Les objets">
                        <field name="metal_nature"/>
                        <field name="quantite"/>
                        <field name="regime_quantite"/>
                        <field name="poids"/>
                        <field name="titre"/>
                        <field name="titre_lot"/>
                        <field name="date_sortie"/>
                    </group>
                </group>
                <group string="Description et provenance">
                    <field name="description" nolabel="1" colspan="2"/>
                    <field name="provenance"/>
                    <field name="protection_patrimoine"/>
                </group>
                <group>
                    <group string="Le vendeur">
                        <field name="vendeur_nom"/>
                        <field name="vendeur_qualite"/>
                        <field name="vendeur_domicile"/>
                        <field name="representant_nom"/>
                        <field name="representant_qualite"/>
                    </group>
                    <group string="La pièce d'identité présentée">
                        <field name="piece_nature"/>
                        <field name="piece_numero"/>
                        <field name="piece_autorite"/>
                        <field name="piece_delivrance"/>
                    </group>
                </group>
                <footer>
                    <button string="Inscrire la rectification" type="object"
                            name="action_rectifier" class="btn-primary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
