<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_journal_form_cheques" model="ir.ui.view">
        <field name="name">account.journal.form.cheques</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group//field[@name='type']" position="after">
                <field name="est_journal_cheques" invisible="type != 'bank'"/>
            </xpath>
        </field>
    </record>

    <!-- Un seul paiement par saisie : plusieurs pièces réglées à part, ce
         sont plusieurs chèques, et un numéro commun serait faux. Le numéro
         se reporte alors sur chaque paiement. -->
    <record id="view_account_payment_register_form_cheques" model="ir.ui.view">
        <field name="name">account.payment.register.form.cheques</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <field name="communication" position="after">
                <field name="numero_cheque"
                       invisible="not est_journal_cheques or not can_edit_wizard or (can_group_payments and not group_payment)"
                       required="est_journal_cheques and can_edit_wizard and not (can_group_payments and not group_payment)"/>
            </field>
        </field>
    </record>

    <!-- Exigé sur un paiement en brouillon seulement : les paiements
         antérieurs au module n'ont pas de numéro, et l'exiger bloquerait
         toute retouche. -->
    <record id="view_account_payment_form_cheques" model="ir.ui.view">
        <field name="name">account.payment.form.cheques</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <field name="memo" position="after">
                <field name="numero_cheque" invisible="not est_journal_cheques"
                       required="est_journal_cheques and state == 'draft'"/>
            </field>
        </field>
    </record>

    <record id="view_account_payment_tree_cheques" model="ir.ui.view">
        <field name="name">account.payment.list.cheques</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <field name="payment_method_line_id" position="after">
                <field name="numero_cheque" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_account_payment_search_cheques" model="ir.ui.view">
        <field name="name">account.payment.search.cheques</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="numero_cheque"/>
            </field>
        </field>
    </record>

    <template id="report_invoice_document_cheques" inherit_id="account.report_invoice_document">
        <xpath expr="//t[@t-out=&quot;payment_vals['date']&quot;]" position="after">
            <t t-if="payment_vals.get('numero_cheque')"> par chèque n° <t t-out="payment_vals['numero_cheque']"/></t>
        </xpath>
    </template>

</odoo>
