{
    // Utilisez IntelliSense pour en savoir plus sur les attributs possibles.
    // Pointez pour afficher la description des attributs existants.
    // Pour plus d'informations, visitez : https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Docker Compose (DebugPy, PgAdmin...)",
            "type": "node-terminal",
            "request": "launch",
            "command": "docker compose up",
            "cwd": "${workspaceFolder}/.dev",
            // "postDebugTask": "🗑️ Cleanup Compose Stack",
            "serverReadyAction": {
                "action": "startDebugging",
                "name": "Attach DebugPy to Odoo",
                "pattern": "wait_for_client()",
                // "name": "Odoo - Launch Browser",
                // "pattern": "Registry loaded",
                "killOnServerStop": true,
            },
            "presentation": {
                "hidden": false,
                "group": "1. Stack",
                "order": 1
            },
            "cascadeTerminateToConfigurations": [
                "Odoo - Launch Browser",
                "PgAdmin - Launch Browser"
            ]
        },
        {
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:8069",
            "name": "Odoo - Launch Browser",
            "presentation": {
                "hidden": false,
                "group": "2. Browser",
                "order": 1
            }
        },
        {
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5050",
            "name": "PgAdmin - Launch Browser",
            "presentation": {
                "hidden": false,
                "group": "2. Browser",
                "order": 2
            }
        },
        {
            "name": "Attach DebugPy to Odoo",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 8888
            },
            "presentation": {
                "hidden": false,
                "group": "1. Stack",
                "order": 2
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/addons",
                    "remoteRoot": "/mnt/extra-addons"
                },
            ],
        },
    ]
}