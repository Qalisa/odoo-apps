{
    // Utilisez IntelliSense pour en savoir plus sur les attributs possibles.
    // Pointez pour afficher la description des attributs existants.
    // Pour plus d'informations, visitez : https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:8069",
            "name": "Launch Browser (Odoo Apps)",
            "presentation": {
                "hidden": false,
                "group": "Odoo Addons",
                "order": 2
            },
            "cascadeTerminateToConfigurations": [
                "Debug: Docker Compose (Odoo Apps)"
            ]
        },
        {
            "name": "Debug Addons",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 8888
            },
            "presentation": {
                "hidden": true,
                "group": "Odoo Addons",
                "order": 3
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/addons",
                    "remoteRoot": "/mnt/extra-addons"
                },
            ],
        },
        {
            "name": "Debug: Docker Compose (Odoo Apps)",
            "type": "node-terminal",
            "request": "launch",
            "command": "docker compose up",
            "cwd": "${workspaceFolder}/.dev/addons",
            "preLaunchTask": "Ensure right permissions for .pgpass (Odoo Apps)",
            "postDebugTask": "Cleanup (Odoo Apps)",
            "serverReadyAction": {
                "action": "startDebugging",
                "name": "Debug Addons",
                "pattern": "wait_for_client()",
                // "name": "Launch Browser (Odoo Apps)",
                // "pattern": "Registry loaded",
                "killOnServerStop": true,
            },
            "presentation": {
                "hidden": false,
                "group": "Odoo Addons",
                "order": 1
            },
            "cascadeTerminateToConfigurations": [
                "Launch Browser (Odoo Apps)"
            ]
        },
        //
        // Docs
        //
        {
            "command": "./node_modules/.bin/astro dev",
            "name": "Debug: Astro Dev (odoo-docs)",
            "request": "launch",
            "type": "node-terminal",
            "cwd": "${workspaceFolder}/docs",
            "serverReadyAction": {
                "action": "debugWithChrome",
                "pattern": "Local",
                "uriFormat": "http://localhost:4321",
                "webRoot": "${workspaceFolder}",
                "killOnServerStop": true
            },
            "presentation": {
                "hidden": false,
                "group": "Odoo Docs",
                "order": 1
            }
        },
        {
            "name": "Debug: Docker Compose (odoo-docs)",
            "type": "node-terminal",
            "request": "launch",
            "command": "docker compose up --build",
            "cwd": "${workspaceFolder}/.dev/docs",
            "serverReadyAction": {
                "action": "debugWithChrome",
                "uriFormat": "http://localhost:4321",
                "pattern": "httpd -D FOREGROUND",
                "killOnServerStop": true
            },
            "presentation": {
                "hidden": false,
                "group": "Odoo Docs",
                "order": 1
            }
        },
    ]
}