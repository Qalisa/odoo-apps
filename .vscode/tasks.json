{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Cleanup",
            "type": "shell",
            "command": "docker compose rm -v -f -s && docker volume rm odoo-apps_odoo-data && docker volume rm odoo-apps_odoo-pg-db",
            "options": {
                "cwd": "${workspaceFolder}/.dev"
            },
            "problemMatcher": []
        },
        {
            "label": "Ensure right permissions for .pgpass",
            "type": "shell",
            "command": "chmod 600 .pgpass",
            "options": {
                "cwd": "${workspaceFolder}/.dev"
            },
            "problemMatcher": []
        },
    ]
}