{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "🗑️ Cleanup Compose Stack",
            "type": "shell",
            "command": "docker compose rm -v -f -s && docker volume rm odoo-apps_odoo-data odoo-apps_postgres-data odoo-apps_pgadmin-data",
            "options": {
                "cwd": "${workspaceFolder}/.dev"
            },
            "problemMatcher": []
        },
        {
            "label": "📘 Generate Taxes (`fr_numismatics_taxes`)",
            "type": "shell",
            "command": "python gen_csv.py",
            "options": {
                "cwd": "${workspaceFolder}/addons/fr_numismatics_taxes/utils"
            }
        },
                {
            "label": "🐙 Populate additionnal addons repos",
            "type": "shell",
            "command": "git submodule update --init --recursive"
        },
    ]
}